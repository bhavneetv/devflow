// Prisma schema file for DevFlow
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
  BACKLOG
  PENDING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TeamMemberRole {
  OWNER
  ADMIN
  DEVELOPER
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  TESTER
  DESIGNER
  PROJECT_MANAGER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum RequirementWorkflowStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  DEPRECATED
  ARCHIVED
}

enum RequirementImplementationStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  IMPLEMENTED
  VERIFIED
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
  BUSINESS
  TECHNICAL
  SECURITY
  PERFORMANCE
  USABILITY
  COMPLIANCE
  INTERFACE
}

enum RequirementPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum DependencyType {
  DEPENDS_ON
  BLOCKS
  RELATED_TO
  ENHANCES
  CONFLICTS_WITH
}

enum LinkTargetType {
  TASK
  COMMIT
  PULL_REQUEST
  TEST
  DEFECT
  RELEASE
  OBJECTIVE
}

enum CategoryScope {
  ORG
  PROJECT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  name                    String
  username                String?                  @unique
  role                    Role                     @default(MEMBER)
  avatarType              String?                  @default("initials")
  avatarUrl               String?                  @db.Text
  avatarId                String?
  avatarColor             String?                  @default("#8B5CF6")
  dateOfBirth             String?
  gender                  String?
  country                 String?
  phoneNumber             String?
  jobTitle                String?
  company                 String?
  bio                     String?                  @db.Text
  isPublicProfile         Boolean                  @default(true)
  onboardingCompleted     Boolean                  @default(false)
  accentColor             String?                  @default("#8B5CF6")
  githubUrl               String?
  linkedinUrl             String?
  websiteUrl              String?
  projects                Project[]                @relation("ProjectOwner")
  ledProjects             Project[]                @relation("ProjectLead")
  projectMemberships      ProjectMember[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTeams            Team[]                   @relation("TeamCreator")
  teamMemberships         TeamMember[]             @relation("TeamMemberships")
  sentInvitations         TeamInvitation[]         @relation("SentInvitations")
  createdOrganizations    Organization[]           @relation("OrganizationCreator")
  organizationMemberships OrganizationMember[]     @relation("OrganizationMemberships")
  orgSentInvitations      OrganizationInvitation[] @relation("OrgSentInvitations")
  orgActivities           OrganizationActivity[]   @relation("OrgActivityActor")
  sentMessages            TeamMessage[]            @relation("MessageSender")
  authoredRequirements    Requirement[]            @relation("RequirementAuthor")
  assignedRequirements    Requirement[]            @relation("RequirementAssignee")
  submittedRequirements   Requirement[]            @relation("RequirementSubmitter")
  approvedRequirements    Requirement[]            @relation("RequirementApprover")
  reviewerOfRequirements  Requirement[]            @relation("RequirementReviewer")
  responsibleRequirements Requirement[]            @relation("RequirementResponsible")
  requirementReviews      RequirementReview[]      @relation("ReviewReviewer")
  requirementVersions     RequirementVersion[]     @relation("VersionChangedBy")
  requirementComments     RequirementComment[]     @relation("CommentAuthor")
  favorites               UserFavorite[]
  notifications           Notification[]           @relation("UserNotifications")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@map("users")
}

model Organization {
  id          Int                      @id @default(autoincrement())
  name        String
  slug        String                   @unique
  description String?                  @db.Text
  logoUrl     String?                  @db.Text
  createdById Int
  createdBy   User                     @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  activities  OrganizationActivity[]
  teams       Team[]
  projects    Project[]
  requirementCategories RequirementCategory[] @relation("OrgCategories")
  requirementTemplates  RequirementTemplate[] @relation("OrgTemplates")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([slug])
  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  id             Int              @id @default(autoincrement())
  organizationId Int
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User             @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id              Int              @id @default(autoincrement())
  organizationId  Int
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById     Int
  invitedBy       User             @relation("OrgSentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedEmail    String
  assignedRole    OrganizationRole @default(MEMBER)
  invitationToken String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  acceptedAt      DateTime?

  @@index([organizationId])
  @@index([invitedEmail])
  @@index([invitationToken])
  @@map("organization_invitations")
}

model OrganizationActivity {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        Int?
  actor          User?        @relation("OrgActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     Int?
  details        String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([createdAt])
  @@map("organization_activities")
}

model Project {
  id             Int             @id @default(autoincrement())
  title          String
  identifier     String?
  description    String?         @db.Text
  status         ProjectStatus   @default(IN_PROGRESS)
  priority       Priority        @default(MEDIUM)
  category       String?         @default("General")
  avatarColor    String?         @default("#8B5CF6")
  avatarIcon     String?         @default("folder")
  startDate      DateTime?
  endDate        DateTime?
  ownerId        Int
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  leadId         Int?
  lead           User?           @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  organizationId Int?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  teamId         Int?
  team           Team?           @relation("TeamProjects", fields: [teamId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  tasks          Task[]
  requirements   Requirement[]
  requirementCategories RequirementCategory[] @relation("ProjectCategories")
  requirementTemplates  RequirementTemplate[] @relation("ProjectTemplates")
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  @@index([ownerId])
  @@index([leadId])
  @@index([organizationId])
  @@index([teamId])
  @@map("projects")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("COLLABORATOR")
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?    @db.Text
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  projectId   Int
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId       Int?
  assignee         User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  requirementLinks RequirementLink[]
  createdAt        DateTime           @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model Team {
  id             Int                     @id @default(autoincrement())
  name           String
  description    String?                 @db.Text
  color          String                  @default("#8B5CF6")
  createdById    Int
  createdBy      User                    @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  organizationId Int?
  organization   Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projects       Project[]               @relation("TeamProjects")
  members        TeamMember[]
  invitations    TeamInvitation[]
  permissions    TeamMemberPermission[]
  conversations  TeamConversation[]
  messages       TeamMessage[]
  responsibleForRequirements Requirement[] @relation("RequirementTeam")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id          Int                     @id @default(autoincrement())
  teamId      Int
  team        Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      Int
  user        User                    @relation("TeamMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role        TeamMemberRole          @default(DEVELOPER)
  joinedAt    DateTime                @default(now())
  permissions TeamMemberPermission[]

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamMemberPermission {
  id                  Int         @id @default(autoincrement())
  teamId              Int
  team                Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId              Int
  teamMember          TeamMember  @relation(fields: [teamId, userId], references: [teamId, userId], onDelete: Cascade)
  manageTeamMembers   Boolean     @default(false)
  removeTeamMembers   Boolean     @default(false)
  manageMemberRoles   Boolean     @default(false)
  manageTeamDetails   Boolean     @default(false)
  manageTeamSettings  Boolean     @default(false)
  manageInvitations   Boolean     @default(false)
  updatedById         Int?
  updatedAt           DateTime    @updatedAt
  createdAt           DateTime    @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_member_permissions")
}

enum ConversationType {
  GROUP
  DIRECT
}

model TeamConversation {
  id             Int              @id @default(autoincrement())
  teamId         Int
  team           Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type           ConversationType @default(GROUP)
  name           String?
  // For DIRECT chats: participantUserIds stores sorted JSON string like "[1,2]"
  participantIds String?          @db.Text
  messages       TeamMessage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([teamId])
  @@index([type])
  @@map("team_conversations")
}

model TeamMessage {
  id             Int              @id @default(autoincrement())
  teamId         Int
  team           Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  conversationId Int
  conversation   TeamConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String           @db.Text
  // JSON array of mentioned user IDs like [12, 15]
  mentions       String?          @db.Text
  // JSON array of user IDs who have read the message like [1, 2]
  readBy         String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([teamId])
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("team_messages")
}

model TeamInvitation {
  id              Int              @id @default(autoincrement())
  teamId          Int
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedById     Int
  invitedBy       User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedEmail    String
  assignedRole    TeamMemberRole   @default(DEVELOPER)
  invitationToken String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  acceptedAt      DateTime?

  @@index([teamId])
  @@index([invitedEmail])
  @@index([invitationToken])
  @@map("team_invitations")
}

model Requirement {
  id                   Int                             @id @default(autoincrement())
  code                 String                          // REQ-001 — unique per project
  projectId            Int
  project              Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  summary              String?                         @db.Text
  type                 RequirementType                 @default(FUNCTIONAL)
  categoryId           Int?
  category             RequirementCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description          String?                         @db.LongText   // rich-text HTML
  businessJustification String?                        @db.Text
  expectedBehavior     String?                         @db.Text
  preconditions        String?                         @db.Text
  constraints          String?                         @db.Text
  dependencies         String?                         @db.Text       // free-form text
  referenceLinks       String?                         @db.Text       // JSON array of URLs
  attachments          String?                         @db.Text       // JSON array of file refs
  priority             RequirementPriority             @default(MEDIUM)
  workflowStatus       RequirementWorkflowStatus       @default(DRAFT)
  implementationStatus RequirementImplementationStatus @default(NOT_STARTED)

  // People
  authorId             Int
  author               User                            @relation("RequirementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  responsibleTeamId    Int?
  responsibleTeam      Team?                           @relation("RequirementTeam", fields: [responsibleTeamId], references: [id], onDelete: SetNull)
  responsibleMemberId  Int?
  responsibleMember    User?                           @relation("RequirementResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)
  reviewerId           Int?
  reviewer             User?                           @relation("RequirementReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assigneeId           Int?
  assignee             User?                           @relation("RequirementAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  collaborators        String?                         @db.Text       // JSON array of user IDs

  // Assessment
  targetDate           DateTime?
  businessImpact       String?                         @db.Text
  riskLevel            RiskLevel?
  complexity           Complexity?

  // Versioning
  currentVersion       Int                             @default(1)

  // Workflow audit
  submittedAt          DateTime?
  submittedById        Int?
  submittedBy          User?                           @relation("RequirementSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  approvedById         Int?
  approvedBy           User?                           @relation("RequirementApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectionReason      String?                         @db.Text

  // Relations
  acceptanceCriteria   AcceptanceCriterion[]
  versions             RequirementVersion[]
  reviews              RequirementReview[]
  dependenciesFrom     RequirementDependency[]         @relation("DepFrom")
  dependenciesTo       RequirementDependency[]         @relation("DepTo")
  comments             RequirementComment[]
  links                RequirementLink[]

  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@unique([projectId, code])
  @@index([projectId])
  @@index([workflowStatus])
  @@index([implementationStatus])
  @@index([authorId])
  @@index([reviewerId])
  @@index([assigneeId])
  @@index([responsibleTeamId])
  @@index([categoryId])
  @@index([priority])
  @@map("requirements")
}

model AcceptanceCriterion {
  id                 Int          @id @default(autoincrement())
  requirementId      Int
  requirement        Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  code               String       // AC-001 — unique per requirement
  description        String       @db.Text
  verificationMethod String?      @db.Text
  relatedTestId      Int?         // nullable — linked when QA module exists
  isComplete         Boolean      @default(false)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([requirementId, code])
  @@index([requirementId])
  @@map("acceptance_criteria")
}

model RequirementCategory {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?          @db.Text
  icon           String?          // icon identifier
  color          String?          // hex color
  defaultType    RequirementType  @default(FUNCTIONAL)
  scope          CategoryScope    @default(PROJECT)
  isActive       Boolean          @default(true)
  organizationId Int?
  organization   Organization?    @relation("OrgCategories", fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      Int?
  project        Project?         @relation("ProjectCategories", fields: [projectId], references: [id], onDelete: Cascade)
  requirements   Requirement[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([scope])
  @@map("requirement_categories")
}

model RequirementTemplate {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?          @db.Text
  structure      String           @db.LongText  // JSON blob
  scope          CategoryScope    @default(ORG)
  isActive       Boolean          @default(true)
  organizationId Int?
  organization   Organization?    @relation("OrgTemplates", fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      Int?
  project        Project?         @relation("ProjectTemplates", fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@map("requirement_templates")
}

model RequirementVersion {
  id              Int                       @id @default(autoincrement())
  requirementId   Int
  requirement     Requirement               @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  versionNumber   Int
  snapshot        String                    @db.LongText  // full JSON snapshot
  changedById     Int
  changedBy       User                      @relation("VersionChangedBy", fields: [changedById], references: [id], onDelete: Cascade)
  changeReason    String?                   @db.Text
  createdAt       DateTime                  @default(now())

  @@unique([requirementId, versionNumber])
  @@index([requirementId])
  @@index([changedById])
  @@map("requirement_versions")
}

model RequirementReview {
  id             Int             @id @default(autoincrement())
  requirementId  Int
  requirement    Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  reviewerId     Int
  reviewer       User            @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  versionNumber  Int             @default(1)
  decision       ReviewDecision
  checklist      String?         @db.Text   // JSON checklist state
  comment        String?         @db.Text
  createdAt      DateTime        @default(now())

  @@index([requirementId])
  @@index([reviewerId])
  @@map("requirement_reviews")
}

model RequirementDependency {
  id                Int             @id @default(autoincrement())
  fromRequirementId Int
  fromRequirement   Requirement     @relation("DepFrom", fields: [fromRequirementId], references: [id], onDelete: Cascade)
  toRequirementId   Int
  toRequirement     Requirement     @relation("DepTo", fields: [toRequirementId], references: [id], onDelete: Cascade)
  type              DependencyType  @default(RELATED_TO)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([fromRequirementId, toRequirementId])
  @@index([fromRequirementId])
  @@index([toRequirementId])
  @@map("requirement_dependencies")
}

model RequirementComment {
  id            Int          @id @default(autoincrement())
  requirementId Int
  requirement   Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  versionId     Int?         // nullable — optional association to a version
  authorId      Int
  author        User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body          String       @db.Text
  mentions      String?      @db.Text       // JSON array of user IDs
  attachments   String?      @db.Text       // JSON array of file refs
  pinned        Boolean      @default(false)
  resolvedAt    DateTime?
  parentId      Int?
  parent        RequirementComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies       RequirementComment[] @relation("CommentReplies")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([requirementId])
  @@index([authorId])
  @@index([parentId])
  @@map("requirement_comments")
}

model RequirementLink {
  id            Int             @id @default(autoincrement())
  requirementId Int
  requirement   Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  targetType    LinkTargetType
  targetId      Int
  isPrimary     Boolean         @default(false)
  taskId        Int?
  task          Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@unique([requirementId, targetType, targetId])
  @@index([requirementId])
  @@index([targetType, targetId])
  @@index([taskId])
  @@map("requirement_links")
}

enum FavoriteResourceType {
  PROJECT
  TEAM
}

model UserFavorite {
  id             Int                  @id @default(autoincrement())
  userId         Int
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType   FavoriteResourceType
  resourceId     Int
  organizationId Int?
  createdAt      DateTime             @default(now())

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_favorites")
}

enum NotificationType {
  ORGANIZATION_INVITATION
  TEAM_INVITATION
  SYSTEM
}

model Notification {
  id                    Int              @id @default(autoincrement())
  recipientId           Int
  recipient             User             @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type                  NotificationType
  title                 String
  message               String           @db.Text
  data                  String?          @db.Text // JSON metadata: { token, invitationId, orgId, orgName, orgSlug, teamId, teamName, role, inviterName }
  isRead                Boolean          @default(false)
  relatedInvitationId   Int?
  relatedOrganizationId Int?
  relatedTeamId         Int?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}
