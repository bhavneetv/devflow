// Prisma schema file for DevFlow
// Docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  MEMBER
  VIEWER
}

enum OrganizationRole {
  OWNER
  ADMIN
  MEMBER
  VIEWER
}

enum ProjectStatus {
  PLANNING
  IN_PROGRESS
  COMPLETED
  ARCHIVED
  BACKLOG
  PENDING
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  IN_REVIEW
  DONE
}

enum Priority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum TeamMemberRole {
  OWNER
  ADMIN
  DEVELOPER
  FRONTEND_DEVELOPER
  BACKEND_DEVELOPER
  TESTER
  DESIGNER
  PROJECT_MANAGER
  VIEWER
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  DECLINED
  CANCELLED
  EXPIRED
}

enum RequirementWorkflowStatus {
  DRAFT
  PENDING_REVIEW
  CHANGES_REQUESTED
  APPROVED
  REJECTED
  DEPRECATED
  ARCHIVED
}

enum RequirementImplementationStatus {
  NOT_STARTED
  IN_PROGRESS
  BLOCKED
  IMPLEMENTED
  VERIFIED
}

enum RequirementType {
  FUNCTIONAL
  NON_FUNCTIONAL
  BUSINESS
  TECHNICAL
  SECURITY
  PERFORMANCE
  USABILITY
  COMPLIANCE
  INTERFACE
}

enum RequirementPriority {
  CRITICAL
  HIGH
  MEDIUM
  LOW
}

enum ReviewDecision {
  APPROVED
  CHANGES_REQUESTED
  REJECTED
}

enum DependencyType {
  DEPENDS_ON
  BLOCKS
  RELATED_TO
  ENHANCES
  CONFLICTS_WITH
}

enum LinkTargetType {
  TASK
  COMMIT
  PULL_REQUEST
  TEST
  DEFECT
  RELEASE
  OBJECTIVE
}

enum CategoryScope {
  ORG
  PROJECT
}

enum RiskLevel {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum Complexity {
  LOW
  MEDIUM
  HIGH
  VERY_HIGH
}

model User {
  id                      Int                      @id @default(autoincrement())
  email                   String                   @unique
  name                    String
  username                String?                  @unique
  role                    Role                     @default(MEMBER)
  avatarType              String?                  @default("initials")
  avatarUrl               String?                  @db.Text
  avatarId                String?
  avatarColor             String?                  @default("#8B5CF6")
  dateOfBirth             String?
  gender                  String?
  country                 String?
  phoneNumber             String?
  jobTitle                String?
  company                 String?
  bio                     String?                  @db.Text
  isPublicProfile         Boolean                  @default(true)
  onboardingCompleted     Boolean                  @default(false)
  accentColor             String?                  @default("#8B5CF6")
  githubUrl               String?
  linkedinUrl             String?
  websiteUrl              String?
  projects                Project[]                @relation("ProjectOwner")
  ledProjects             Project[]                @relation("ProjectLead")
  projectMemberships      ProjectMember[]
  assignedTasks           Task[]                   @relation("TaskAssignee")
  createdTeams            Team[]                   @relation("TeamCreator")
  teamMemberships         TeamMember[]             @relation("TeamMemberships")
  sentInvitations         TeamInvitation[]         @relation("SentInvitations")
  createdOrganizations    Organization[]           @relation("OrganizationCreator")
  organizationMemberships OrganizationMember[]     @relation("OrganizationMemberships")
  orgSentInvitations      OrganizationInvitation[] @relation("OrgSentInvitations")
  orgActivities           OrganizationActivity[]   @relation("OrgActivityActor")
  sentMessages            TeamMessage[]            @relation("MessageSender")
  authoredRequirements    Requirement[]            @relation("RequirementAuthor")
  assignedRequirements    Requirement[]            @relation("RequirementAssignee")
  submittedRequirements   Requirement[]            @relation("RequirementSubmitter")
  approvedRequirements    Requirement[]            @relation("RequirementApprover")
  reviewerOfRequirements  Requirement[]            @relation("RequirementReviewer")
  responsibleRequirements Requirement[]            @relation("RequirementResponsible")
  requirementReviews      RequirementReview[]      @relation("ReviewReviewer")
  requirementVersions     RequirementVersion[]     @relation("VersionChangedBy")
  requirementComments     RequirementComment[]     @relation("CommentAuthor")
  favorites               UserFavorite[]
  notifications           Notification[]           @relation("UserNotifications")
  createdModules          ProjectModule[]          @relation("ModuleCreator")
  createdSubmodules       ProjectSubmodule[]       @relation("SubmoduleCreator")
  gitConnections          GitProviderConnection[]
  createdGitRecordLinks   GitRecordLink[]          @relation("GitRecordLinkCreator")
  gitMemberMappings       GitMemberMapping[]       @relation("UserGitMappings")
  uploadedDocuments       ProjectDocument[]        @relation("DocumentUploader")
  createdDocumentCategories DocumentCategory[]     @relation("DocumentCategoryCreator")
  documentSharesCreated   DocumentShare[]          @relation("DocumentShareCreator")
  documentSharesReceived  DocumentShare[]          @relation("DocumentShareRecipient")
  documentActivities      DocumentActivity[]       @relation("DocumentActivityActor")
  createdDevModules       DevelopmentModule[]      @relation("DevModuleCreator")
  createdDevSubmodules    DevelopmentSubmodule[]   @relation("DevSubmoduleCreator")
  createdDevTasks         DevelopmentTask[]        @relation("DevTaskCreator")
  devTaskAssignments      DevelopmentTaskAssignee[] @relation("DevTaskAssigneeUser")
  devTasksAssignedBy      DevelopmentTaskAssignee[] @relation("DevTaskAssignedByUser")
  devTaskAttachments      DevelopmentTaskAttachment[] @relation("DevTaskAttachmentUploader")
  devTaskComments         DevelopmentTaskComment[] @relation("DevTaskCommentAuthor")
  devTaskActivities       DevelopmentTaskActivity[] @relation("DevTaskActivityActor")
  createdAt               DateTime                 @default(now())
  updatedAt               DateTime                 @updatedAt

  @@map("users")
}

model Organization {
  id          Int                      @id @default(autoincrement())
  name        String
  slug        String                   @unique
  description String?                  @db.Text
  logoUrl     String?                  @db.Text
  createdById Int
  createdBy   User                     @relation("OrganizationCreator", fields: [createdById], references: [id], onDelete: Cascade)
  members     OrganizationMember[]
  invitations OrganizationInvitation[]
  activities  OrganizationActivity[]
  teams       Team[]
  projects    Project[]
  requirementCategories RequirementCategory[] @relation("OrgCategories")
  requirementTemplates  RequirementTemplate[] @relation("OrgTemplates")
  createdAt   DateTime                 @default(now())
  updatedAt   DateTime                 @updatedAt

  @@index([slug])
  @@index([createdById])
  @@map("organizations")
}

model OrganizationMember {
  id             Int              @id @default(autoincrement())
  organizationId Int
  organization   Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         Int
  user           User             @relation("OrganizationMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role           OrganizationRole @default(MEMBER)
  joinedAt       DateTime         @default(now())

  @@unique([organizationId, userId])
  @@index([organizationId])
  @@index([userId])
  @@map("organization_members")
}

model OrganizationInvitation {
  id              Int              @id @default(autoincrement())
  organizationId  Int
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  invitedById     Int
  invitedBy       User             @relation("OrgSentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedEmail    String
  assignedRole    OrganizationRole @default(MEMBER)
  invitationToken String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  acceptedAt      DateTime?

  @@index([organizationId])
  @@index([invitedEmail])
  @@index([invitationToken])
  @@map("organization_invitations")
}

model OrganizationActivity {
  id             Int          @id @default(autoincrement())
  organizationId Int
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  actorId        Int?
  actor          User?        @relation("OrgActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action         String
  resourceType   String
  resourceId     Int?
  details        String?      @db.Text
  createdAt      DateTime     @default(now())

  @@index([organizationId])
  @@index([actorId])
  @@index([createdAt])
  @@map("organization_activities")
}

model Project {
  id             Int             @id @default(autoincrement())
  title          String
  identifier     String?
  description    String?         @db.Text
  status         ProjectStatus   @default(IN_PROGRESS)
  priority       Priority        @default(MEDIUM)
  category       String?         @default("General")
  avatarColor    String?         @default("#8B5CF6")
  avatarIcon     String?         @default("folder")
  startDate      DateTime?
  endDate        DateTime?
  ownerId        Int
  owner          User            @relation("ProjectOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  leadId         Int?
  lead           User?           @relation("ProjectLead", fields: [leadId], references: [id], onDelete: SetNull)
  organizationId Int?
  organization   Organization?   @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  teamId         Int?
  team           Team?           @relation("TeamProjects", fields: [teamId], references: [id], onDelete: SetNull)
  members        ProjectMember[]
  tasks          Task[]
  modules               ProjectModule[]
  submodules            ProjectSubmodule[]
  requirements          Requirement[]
  requirementCategories RequirementCategory[] @relation("ProjectCategories")
  requirementTemplates  RequirementTemplate[] @relation("ProjectTemplates")
  gitConnections        GitProviderConnection[]
  gitRepositories       GitRepositoryConnection[]
  gitRecordLinks        GitRecordLink[]
  gitMemberMappings     GitMemberMapping[]
  storageConnection     ProjectStorageConnection?
  documents             ProjectDocument[]
  documentCategories    DocumentCategory[]
  documentSettings      DocumentModuleSettings?
  documentActivities    DocumentActivity[]
  developmentModules    DevelopmentModule[]
  developmentSubmodules DevelopmentSubmodule[]
  developmentTasks      DevelopmentTask[]
  developmentAttachments DevelopmentTaskAttachment[]
  developmentActivities DevelopmentTaskActivity[]
  developmentConfig     DevelopmentProjectConfig?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt

  @@index([ownerId])
  @@index([leadId])
  @@index([organizationId])
  @@index([teamId])
  @@map("projects")
}

model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("COLLABORATOR")
  joinedAt  DateTime @default(now())

  @@unique([projectId, userId])
  @@index([projectId])
  @@index([userId])
  @@map("project_members")
}

model Task {
  id          Int        @id @default(autoincrement())
  title       String
  description String?    @db.Text
  priority    Priority   @default(MEDIUM)
  status      TaskStatus @default(TODO)
  dueDate     DateTime?
  projectId   Int
  project     Project    @relation(fields: [projectId], references: [id], onDelete: Cascade)
  assigneeId       Int?
  assignee         User?              @relation("TaskAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  requirementLinks RequirementLink[]
  createdAt        DateTime           @default(now())
  updatedAt   DateTime   @updatedAt

  @@index([projectId])
  @@index([assigneeId])
  @@map("tasks")
}

model Team {
  id             Int                     @id @default(autoincrement())
  name           String
  description    String?                 @db.Text
  color          String                  @default("#8B5CF6")
  createdById    Int
  createdBy      User                    @relation("TeamCreator", fields: [createdById], references: [id], onDelete: Cascade)
  organizationId Int?
  organization   Organization?           @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  projects       Project[]               @relation("TeamProjects")
  members        TeamMember[]
  invitations    TeamInvitation[]
  permissions    TeamMemberPermission[]
  conversations  TeamConversation[]
  messages       TeamMessage[]
  responsibleForRequirements Requirement[] @relation("RequirementTeam")
  createdAt      DateTime                @default(now())
  updatedAt      DateTime                @updatedAt

  @@index([organizationId])
  @@map("teams")
}

model TeamMember {
  id          Int                     @id @default(autoincrement())
  teamId      Int
  team        Team                    @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId      Int
  user        User                    @relation("TeamMemberships", fields: [userId], references: [id], onDelete: Cascade)
  role        TeamMemberRole          @default(DEVELOPER)
  joinedAt    DateTime                @default(now())
  permissions TeamMemberPermission[]

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_members")
}

model TeamMemberPermission {
  id                  Int         @id @default(autoincrement())
  teamId              Int
  team                Team        @relation(fields: [teamId], references: [id], onDelete: Cascade)
  userId              Int
  teamMember          TeamMember  @relation(fields: [teamId, userId], references: [teamId, userId], onDelete: Cascade)
  manageTeamMembers   Boolean     @default(false)
  removeTeamMembers   Boolean     @default(false)
  manageMemberRoles   Boolean     @default(false)
  manageTeamDetails   Boolean     @default(false)
  manageTeamSettings  Boolean     @default(false)
  manageInvitations   Boolean     @default(false)
  updatedById         Int?
  updatedAt           DateTime    @updatedAt
  createdAt           DateTime    @default(now())

  @@unique([teamId, userId])
  @@index([teamId])
  @@index([userId])
  @@map("team_member_permissions")
}

enum ConversationType {
  GROUP
  DIRECT
}

model TeamConversation {
  id             Int              @id @default(autoincrement())
  teamId         Int
  team           Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  type           ConversationType @default(GROUP)
  name           String?
  // For DIRECT chats: participantUserIds stores sorted JSON string like "[1,2]"
  participantIds String?          @db.Text
  isPinned       Boolean          @default(false)
  messages       TeamMessage[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([teamId])
  @@index([type])
  @@map("team_conversations")
}

model TeamMessage {
  id             Int              @id @default(autoincrement())
  teamId         Int
  team           Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  conversationId Int
  conversation   TeamConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       Int
  sender         User             @relation("MessageSender", fields: [senderId], references: [id], onDelete: Cascade)
  content        String           @db.Text
  // JSON array of mentioned user IDs like [12, 15]
  mentions       String?          @db.Text
  // JSON array of user IDs who have read the message like [1, 2]
  readBy         String?          @db.Text
  replyToId      Int?
  isPinned       Boolean          @default(false)
  isEdited       Boolean          @default(false)
  isDeleted      Boolean          @default(false)
  attachments    String?          @db.Text
  sharedEntity   String?          @db.Text
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([teamId])
  @@index([conversationId])
  @@index([senderId])
  @@index([createdAt])
  @@map("team_messages")
}

model TeamInvitation {
  id              Int              @id @default(autoincrement())
  teamId          Int
  team            Team             @relation(fields: [teamId], references: [id], onDelete: Cascade)
  invitedById     Int
  invitedBy       User             @relation("SentInvitations", fields: [invitedById], references: [id], onDelete: Cascade)
  invitedEmail    String
  assignedRole    TeamMemberRole   @default(DEVELOPER)
  invitationToken String           @unique
  status          InvitationStatus @default(PENDING)
  expiresAt       DateTime
  createdAt       DateTime         @default(now())
  acceptedAt      DateTime?

  @@index([teamId])
  @@index([invitedEmail])
  @@index([invitationToken])
  @@map("team_invitations")
}

model Requirement {
  id                   Int                             @id @default(autoincrement())
  code                 String                          // REQ-001 — unique per project
  projectId            Int
  project              Project                         @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title                String
  summary              String?                         @db.Text
  type                 RequirementType                 @default(FUNCTIONAL)
  categoryId           Int?
  category             RequirementCategory?            @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description          String?                         @db.LongText   // rich-text HTML
  businessJustification String?                        @db.Text
  expectedBehavior     String?                         @db.Text
  preconditions        String?                         @db.Text
  constraints          String?                         @db.Text
  dependencies         String?                         @db.Text       // free-form text
  referenceLinks       String?                         @db.Text       // JSON array of URLs
  attachments          String?                         @db.Text       // JSON array of file refs
  priority             RequirementPriority             @default(MEDIUM)
  workflowStatus       RequirementWorkflowStatus       @default(DRAFT)
  implementationStatus RequirementImplementationStatus @default(NOT_STARTED)

  // People
  authorId             Int
  author               User                            @relation("RequirementAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  responsibleTeamId    Int?
  responsibleTeam      Team?                           @relation("RequirementTeam", fields: [responsibleTeamId], references: [id], onDelete: SetNull)
  responsibleMemberId  Int?
  responsibleMember    User?                           @relation("RequirementResponsible", fields: [responsibleMemberId], references: [id], onDelete: SetNull)
  reviewerId           Int?
  reviewer             User?                           @relation("RequirementReviewer", fields: [reviewerId], references: [id], onDelete: SetNull)
  assigneeId           Int?
  assignee             User?                           @relation("RequirementAssignee", fields: [assigneeId], references: [id], onDelete: SetNull)
  collaborators        String?                         @db.Text       // JSON array of user IDs

  // Assessment
  targetDate           DateTime?
  businessImpact       String?                         @db.Text
  riskLevel            RiskLevel?
  complexity           Complexity?

  // Versioning
  currentVersion       Int                             @default(1)

  // Workflow audit
  submittedAt          DateTime?
  submittedById        Int?
  submittedBy          User?                           @relation("RequirementSubmitter", fields: [submittedById], references: [id], onDelete: SetNull)
  approvedAt           DateTime?
  approvedById         Int?
  approvedBy           User?                           @relation("RequirementApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  rejectionReason      String?                         @db.Text

  // Relations
  acceptanceCriteria   AcceptanceCriterion[]
  versions             RequirementVersion[]
  reviews              RequirementReview[]
  dependenciesFrom     RequirementDependency[]         @relation("DepFrom")
  dependenciesTo       RequirementDependency[]         @relation("DepTo")
  comments             RequirementComment[]
  links                RequirementLink[]

  createdAt            DateTime                        @default(now())
  updatedAt            DateTime                        @updatedAt

  @@unique([projectId, code])
  @@index([projectId])
  @@index([workflowStatus])
  @@index([implementationStatus])
  @@index([authorId])
  @@index([reviewerId])
  @@index([assigneeId])
  @@index([responsibleTeamId])
  @@index([categoryId])
  @@index([priority])
  @@map("requirements")
}

model AcceptanceCriterion {
  id                 Int          @id @default(autoincrement())
  requirementId      Int
  requirement        Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  code               String       // AC-001 — unique per requirement
  description        String       @db.Text
  verificationMethod String?      @db.Text
  relatedTestId      Int?         // nullable — linked when QA module exists
  isComplete         Boolean      @default(false)
  sortOrder          Int          @default(0)
  createdAt          DateTime     @default(now())
  updatedAt          DateTime     @updatedAt

  @@unique([requirementId, code])
  @@index([requirementId])
  @@map("acceptance_criteria")
}

model RequirementCategory {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?          @db.Text
  icon           String?          // icon identifier
  color          String?          // hex color
  defaultType    RequirementType  @default(FUNCTIONAL)
  scope          CategoryScope    @default(PROJECT)
  isActive       Boolean          @default(true)
  organizationId Int?
  organization   Organization?    @relation("OrgCategories", fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      Int?
  project        Project?         @relation("ProjectCategories", fields: [projectId], references: [id], onDelete: Cascade)
  requirements   Requirement[]
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@index([scope])
  @@map("requirement_categories")
}

model RequirementTemplate {
  id             Int              @id @default(autoincrement())
  name           String
  description    String?          @db.Text
  structure      String           @db.LongText  // JSON blob
  scope          CategoryScope    @default(ORG)
  isActive       Boolean          @default(true)
  organizationId Int?
  organization   Organization?    @relation("OrgTemplates", fields: [organizationId], references: [id], onDelete: Cascade)
  projectId      Int?
  project        Project?         @relation("ProjectTemplates", fields: [projectId], references: [id], onDelete: Cascade)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  @@index([organizationId])
  @@index([projectId])
  @@map("requirement_templates")
}

model RequirementVersion {
  id              Int                       @id @default(autoincrement())
  requirementId   Int
  requirement     Requirement               @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  versionNumber   Int
  snapshot        String                    @db.LongText  // full JSON snapshot
  changedById     Int
  changedBy       User                      @relation("VersionChangedBy", fields: [changedById], references: [id], onDelete: Cascade)
  changeReason    String?                   @db.Text
  createdAt       DateTime                  @default(now())

  @@unique([requirementId, versionNumber])
  @@index([requirementId])
  @@index([changedById])
  @@map("requirement_versions")
}

model RequirementReview {
  id             Int             @id @default(autoincrement())
  requirementId  Int
  requirement    Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  reviewerId     Int
  reviewer       User            @relation("ReviewReviewer", fields: [reviewerId], references: [id], onDelete: Cascade)
  versionNumber  Int             @default(1)
  decision       ReviewDecision
  checklist      String?         @db.Text   // JSON checklist state
  comment        String?         @db.Text
  createdAt      DateTime        @default(now())

  @@index([requirementId])
  @@index([reviewerId])
  @@map("requirement_reviews")
}

model RequirementDependency {
  id                Int             @id @default(autoincrement())
  fromRequirementId Int
  fromRequirement   Requirement     @relation("DepFrom", fields: [fromRequirementId], references: [id], onDelete: Cascade)
  toRequirementId   Int
  toRequirement     Requirement     @relation("DepTo", fields: [toRequirementId], references: [id], onDelete: Cascade)
  type              DependencyType  @default(RELATED_TO)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  @@unique([fromRequirementId, toRequirementId])
  @@index([fromRequirementId])
  @@index([toRequirementId])
  @@map("requirement_dependencies")
}

model RequirementComment {
  id            Int          @id @default(autoincrement())
  requirementId Int
  requirement   Requirement  @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  versionId     Int?         // nullable — optional association to a version
  authorId      Int
  author        User         @relation("CommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body          String       @db.Text
  mentions      String?      @db.Text       // JSON array of user IDs
  attachments   String?      @db.Text       // JSON array of file refs
  pinned        Boolean      @default(false)
  resolvedAt    DateTime?
  parentId      Int?
  parent        RequirementComment?  @relation("CommentReplies", fields: [parentId], references: [id], onDelete: SetNull)
  replies       RequirementComment[] @relation("CommentReplies")
  createdAt     DateTime     @default(now())
  updatedAt     DateTime     @updatedAt

  @@index([requirementId])
  @@index([authorId])
  @@index([parentId])
  @@map("requirement_comments")
}

model RequirementLink {
  id            Int             @id @default(autoincrement())
  requirementId Int
  requirement   Requirement     @relation(fields: [requirementId], references: [id], onDelete: Cascade)
  targetType    LinkTargetType
  targetId      Int
  isPrimary     Boolean         @default(false)
  taskId        Int?
  task          Task?           @relation(fields: [taskId], references: [id], onDelete: SetNull)
  createdAt     DateTime        @default(now())

  @@unique([requirementId, targetType, targetId])
  @@index([requirementId])
  @@index([targetType, targetId])
  @@index([taskId])
  @@map("requirement_links")
}

enum FavoriteResourceType {
  PROJECT
  TEAM
}

model UserFavorite {
  id             Int                  @id @default(autoincrement())
  userId         Int
  user           User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  resourceType   FavoriteResourceType
  resourceId     Int
  organizationId Int?
  createdAt      DateTime             @default(now())

  @@unique([userId, resourceType, resourceId])
  @@index([userId])
  @@index([organizationId])
  @@map("user_favorites")
}

enum NotificationType {
  ORGANIZATION_INVITATION
  TEAM_INVITATION
  ORGANIZATION_JOIN_REQUEST
  SYSTEM
}

model Notification {
  id                    Int              @id @default(autoincrement())
  recipientId           Int
  recipient             User             @relation("UserNotifications", fields: [recipientId], references: [id], onDelete: Cascade)
  type                  NotificationType
  title                 String
  message               String           @db.Text
  data                  String?          @db.Text // JSON metadata: { token, invitationId, orgId, orgName, orgSlug, teamId, teamName, role, inviterName }
  isRead                Boolean          @default(false)
  relatedInvitationId   Int?
  relatedOrganizationId Int?
  relatedTeamId         Int?
  createdAt             DateTime         @default(now())
  updatedAt             DateTime         @updatedAt

  @@index([recipientId])
  @@index([isRead])
  @@index([createdAt])
  @@map("notifications")
}

model ProjectModule {
  id          Int      @id @default(autoincrement())
  projectId   Int      @map("project_id")
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  description String?  @db.Text
  icon        String?  @default("folder")
  position    Int      @default(0)
  isVisible   Boolean  @default(true) @map("is_visible")
  isPinned    Boolean  @default(false) @map("is_pinned")
  createdById Int?     @map("created_by")
  createdBy   User?    @relation("ModuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  submodules ProjectSubmodule[]

  @@unique([projectId, name])
  @@index([projectId])
  @@index([createdById])
  @@map("project_modules")
}

model ProjectSubmodule {
  id          Int           @id @default(autoincrement())
  projectId   Int           @map("project_id")
  project     Project       @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId    Int           @map("module_id")
  module      ProjectModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name        String
  icon        String?       @default("circle-dot")
  type        String        @default("custom") // "built_in" | "custom" | "composite"
  builtInKey  String?       @map("built_in_key")
  config      String?       @db.Text
  position    Int           @default(0)
  isVisible   Boolean       @default(true) @map("is_visible")
  isPinned    Boolean       @default(false) @map("is_pinned")
  createdById Int?          @map("created_by")
  createdBy   User?         @relation("SubmoduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime      @default(now()) @map("created_at")
  updatedAt   DateTime      @updatedAt @map("updated_at")

  documents          ProjectDocument[]
  documentCategories DocumentCategory[]

  @@unique([moduleId, name])
  @@index([projectId])
  @@index([moduleId])
  @@index([createdById])
  @@map("project_submodules")
}

model GitProviderConnection {
  id             Int                       @id @default(autoincrement())
  projectId      Int                       @map("project_id")
  project        Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  organizationId Int?                      @map("organization_id")
  userId         Int                       @map("user_id")
  user           User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  provider       String                    // "github" | "gitlab"
  authType       String                    @default("pat") @map("auth_type")
  tokenEncrypted String                    @db.Text @map("token_encrypted")
  tokenIv        String                    @map("token_iv")
  tokenTag       String                    @map("token_tag")
  accountName    String                    @map("account_name")
  accountEmail   String?                   @map("account_email")
  avatarUrl      String?                   @db.Text @map("avatar_url")
  status         String                    @default("active")
  scopes         String?                   @db.Text
  createdAt      DateTime                  @default(now()) @map("created_at")
  updatedAt      DateTime                  @updatedAt @map("updated_at")

  repositories       GitRepositoryConnection[]
  storageConnections ProjectStorageConnection[]

  @@index([projectId])
  @@index([userId])
  @@map("git_provider_connections")
}

model GitRepositoryConnection {
  id             Int                    @id @default(autoincrement())
  projectId      Int                    @map("project_id")
  project        Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  connectionId       Int                    @map("connection_id")
  providerConnection GitProviderConnection  @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  providerRepoId String                 @map("provider_repo_id")
  name           String
  fullName       String                 @map("full_name")
  owner          String
  defaultBranch  String                 @default("main") @map("default_branch")
  isPrivate      Boolean                @default(false) @map("is_private")
  webUrl         String                 @map("web_url")
  cloneUrl       String?                @map("clone_url")
  syncStatus     String                 @default("healthy") @map("sync_status")
  lastSyncAt     DateTime?              @map("last_sync_at")
  createdAt      DateTime               @default(now()) @map("created_at")
  updatedAt      DateTime               @updatedAt @map("updated_at")

  recordLinks    GitRecordLink[]

  @@unique([projectId, fullName])
  @@index([projectId])
  @@index([connectionId])
  @@map("git_repository_connections")
}

model GitRecordLink {
  id           Int                      @id @default(autoincrement())
  projectId    Int                      @map("project_id")
  project      Project                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  repositoryId Int                      @map("repository_id")
  repository   GitRepositoryConnection  @relation(fields: [repositoryId], references: [id], onDelete: Cascade)
  provider     String                   // "github" | "gitlab"
  recordType   String                   @map("record_type") // "issue" | "merge_request"
  recordNumber Int?                     @map("record_number")
  recordId     String                   @map("record_id")
  recordTitle  String?                  @map("record_title")
  recordUrl    String?                  @map("record_url")
    targetType   String                   @map("target_type") // "task" | "requirement" | "defect"
  targetId     Int                      @map("target_id")
  createdById  Int?                     @map("created_by")
  createdBy    User?                    @relation("GitRecordLinkCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt    DateTime                 @default(now()) @map("created_at")
  updatedAt    DateTime                 @updatedAt @map("updated_at")

  @@unique([projectId, recordId, targetType, targetId])
  @@index([projectId])
  @@index([repositoryId])
  @@index([targetType, targetId])
  @@map("git_record_links")
}

model GitMemberMapping {
  id             Int       @id @default(autoincrement())
  projectId      Int       @map("project_id")
  project        Project   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId         Int       @map("user_id")
  user           User      @relation("UserGitMappings", fields: [userId], references: [id], onDelete: Cascade)
  gitUsername    String?   @map("git_username")
  gitEmail       String?   @map("git_email")
  gitName        String?   @map("git_name")
  avatarUrl      String?   @db.Text @map("avatar_url")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")

  @@index([projectId])
  @@index([userId])
  @@map("git_member_mappings")
}

model ProjectStorageConnection {
  id                   Int                       @id @default(autoincrement())
  projectId            Int                       @unique @map("project_id")
  project              Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  provider             String                    @default("github")
  providerAccountId    String?                   @map("provider_account_id")
  providerOwner        String                    @map("provider_owner")
  providerRepoId       String                    @map("provider_repo_id")
  repositoryName       String                    @map("repository_name")
  repositoryUrl        String                    @map("repository_url")
  defaultBranch        String                    @default("main") @map("default_branch")
  connectionStatus     String                    @default("connected") @map("connection_status")
  lastSyncAt           DateTime?                 @map("last_sync_at")
  trackedSizeBytes     BigInt                    @default(0) @map("tracked_size_bytes")
  providerConnectionId Int?                      @map("provider_connection_id")
  providerConnection   GitProviderConnection?    @relation(fields: [providerConnectionId], references: [id], onDelete: SetNull)
  createdAt            DateTime                  @default(now()) @map("created_at")
  updatedAt            DateTime                  @updatedAt @map("updated_at")

  documents            ProjectDocument[]
  settings             DocumentModuleSettings?

  @@index([providerOwner, repositoryName])
  @@index([providerConnectionId])
  @@map("project_storage_connections")
}

model DocumentCategory {
  id          Int               @id @default(autoincrement())
  projectId   Int               @map("project_id")
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submoduleId Int?              @map("submodule_id")
  submodule   ProjectSubmodule? @relation(fields: [submoduleId], references: [id], onDelete: SetNull)
  name        String
  slug        String
  description String?           @db.Text
  icon        String?
  color       String?
  position    Int               @default(0)
  createdById Int?              @map("created_by")
  createdBy   User?             @relation("DocumentCategoryCreator", fields: [createdById], references: [id], onDelete: SetNull)
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  documents   ProjectDocument[]

  @@unique([projectId, slug])
  @@index([projectId])
  @@index([submoduleId])
  @@map("document_categories")
}

model ProjectDocument {
  id                  Int                       @id @default(autoincrement())
  organizationId      Int?                      @map("organization_id")
  projectId           Int                       @map("project_id")
  project             Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  submoduleId         Int?                      @map("submodule_id")
  submodule           ProjectSubmodule?         @relation(fields: [submoduleId], references: [id], onDelete: SetNull)
  storageConnectionId Int?                      @map("storage_connection_id")
  storageConnection   ProjectStorageConnection? @relation(fields: [storageConnectionId], references: [id], onDelete: SetNull)
  uploadedById        Int                       @map("uploaded_by")
  uploadedBy          User                      @relation("DocumentUploader", fields: [uploadedById], references: [id], onDelete: Cascade)
  originalName        String                    @map("original_name")
  displayName         String                    @map("display_name")
  storageKey          String                    @unique @map("storage_key")
  branch              String?                   @map("branch")
  repositoryPath      String                    @map("repository_path")
  providerFileSha     String?                   @map("provider_file_sha")
  mimeType            String                    @map("mime_type")
  extension           String
  sizeBytes           Int                       @map("size_bytes")
  categoryId          Int?                      @map("category_id")
  category            DocumentCategory?         @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  description         String?                   @db.Text
  tags                String?                   @db.Text
  visibility          String                    @default("project")
  uploadStatus        String                    @default("uploaded") @map("upload_status")
  providerSyncStatus  String                    @default("synced") @map("provider_sync_status")
  deletedAt           DateTime?                 @map("deleted_at")
  createdAt           DateTime                  @default(now()) @map("created_at")
  updatedAt           DateTime                  @updatedAt @map("updated_at")

  shares              DocumentShare[]
  activities          DocumentActivity[]
  developmentAttachments DevelopmentTaskAttachment[]

  @@index([projectId])
  @@index([submoduleId])
  @@index([categoryId])
  @@index([uploadedById])
  @@index([storageConnectionId])
  @@map("project_documents")
}

model DocumentShare {
  id                 Int             @id @default(autoincrement())
  documentId         Int             @map("document_id")
  document           ProjectDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)
  shareType          String          @map("share_type") // "internal_member" | "internal_team" | "external_link"
  recipientUserId    Int?            @map("recipient_user_id")
  recipientUser      User?           @relation("DocumentShareRecipient", fields: [recipientUserId], references: [id], onDelete: Cascade)
  recipientTeamId    Int?            @map("recipient_team_id")
  tokenHash          String?         @unique @map("token_hash")
  accessPasswordHash String?         @map("access_password_hash")
  permissionLevel    String          @default("view") @map("permission_level") // "view" | "download" | "full"
  shareMessage       String?         @map("share_message") @db.Text
  allowApproval      Boolean         @default(false) @map("allow_approval")
  approvalStatus     String?         @map("approval_status") // "pending" | "approved" | "declined"
  approvalActorName  String?         @map("approval_actor_name")
  approvalNote       String?         @map("approval_note") @db.Text
  approvalActedAt    DateTime?       @map("approval_acted_at")
  expiresAt          DateTime?       @map("expires_at")
  revokedAt          DateTime?       @map("revoked_at")
  createdById        Int             @map("created_by")
  createdBy          User            @relation("DocumentShareCreator", fields: [createdById], references: [id], onDelete: Cascade)
  createdAt          DateTime        @default(now()) @map("created_at")

  @@index([documentId])
  @@index([recipientUserId])
  @@index([tokenHash])
  @@map("document_shares")
}

model DocumentActivity {
  id         Int              @id @default(autoincrement())
  documentId Int?             @map("document_id")
  document   ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: Cascade)
  projectId  Int              @map("project_id")
  project    Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  actorId    Int?             @map("actor_id")
  actor      User?            @relation("DocumentActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action     String           // "upload" | "download" | "preview" | "rename" | "category_change" | "share_created" | "share_revoked" | "delete" | "github_sync"
  metadata   String?          @db.Text
  createdAt  DateTime         @default(now()) @map("created_at")

  @@index([projectId])
  @@index([documentId])
  @@index([actorId])
  @@map("document_activities")
}

model DocumentModuleSettings {
  id                      Int                       @id @default(autoincrement())
  projectId               Int                       @unique @map("project_id")
  project                 Project                   @relation(fields: [projectId], references: [id], onDelete: Cascade)
  storageConnectionId     Int?                      @unique @map("storage_connection_id")
  storageConnection       ProjectStorageConnection? @relation(fields: [storageConnectionId], references: [id], onDelete: SetNull)
  maxFileSizeBytes        Int                       @default(26214400) @map("max_file_size_bytes") // 25 MB
  maxFilesPerBatch        Int                       @default(10) @map("max_files_per_batch")
  allowedExtensions       String                    @default("*") @map("allowed_extensions")
  allowedMimeTypes        String                    @default("*") @map("allowed_mime_types")
  duplicatePolicy         String                    @default("rename") @map("duplicate_policy") // "rename" | "replace" | "reject"
  externalSharingEnabled  Boolean                   @default(true) @map("external_sharing_enabled")
  providerDeletionEnabled Boolean                   @default(true) @map("provider_deletion_enabled")
  defaultCategoryId       Int?                      @map("default_category_id")
  updatedById             Int?                      @map("updated_by")
  updatedAt               DateTime                  @updatedAt @map("updated_at")

  @@map("document_module_settings")
}

// ─── DEVELOPMENT MANAGEMENT MODULE ─────────────────────────────────────────────

model DevelopmentModule {
  id          Int                    @id @default(autoincrement())
  projectId   Int                    @map("project_id")
  project     Project                @relation(fields: [projectId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?                @db.Text
  icon        String?
  color       String?
  position    Int                    @default(0)
  isArchived  Boolean                @default(false) @map("is_archived")
  archivedAt  DateTime?              @map("archived_at")
  createdById Int?                   @map("created_by")
  createdBy   User?                  @relation("DevModuleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  submodules  DevelopmentSubmodule[]
  tasks       DevelopmentTask[]
  createdAt   DateTime               @default(now()) @map("created_at")
  updatedAt   DateTime               @updatedAt @map("updated_at")

  @@unique([projectId, slug])
  @@index([projectId, isArchived])
  @@map("development_modules")
}

model DevelopmentSubmodule {
  id          Int               @id @default(autoincrement())
  projectId   Int               @map("project_id")
  project     Project           @relation(fields: [projectId], references: [id], onDelete: Cascade)
  moduleId    Int               @map("module_id")
  module      DevelopmentModule @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  name        String
  slug        String
  description String?           @db.Text
  icon        String?
  position    Int               @default(0)
  isArchived  Boolean           @default(false) @map("is_archived")
  archivedAt  DateTime?         @map("archived_at")
  createdById Int?              @map("created_by")
  createdBy   User?             @relation("DevSubmoduleCreator", fields: [createdById], references: [id], onDelete: SetNull)
  tasks       DevelopmentTask[]
  createdAt   DateTime          @default(now()) @map("created_at")
  updatedAt   DateTime          @updatedAt @map("updated_at")

  @@unique([moduleId, slug])
  @@index([projectId, moduleId, isArchived])
  @@map("development_submodules")
}

model DevelopmentTask {
  id              Int                         @id @default(autoincrement())
  projectId       Int                         @map("project_id")
  project         Project                     @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskKey         String                      @map("task_key")
  sequenceNumber  Int                         @map("sequence_number")
  title           String
  description     String?                     @db.Text
  taskType        String                      @default("Task") @map("task_type")
  moduleId        Int                         @map("module_id")
  module          DevelopmentModule           @relation(fields: [moduleId], references: [id], onDelete: Restrict)
  submoduleId     Int                         @map("submodule_id")
  submodule       DevelopmentSubmodule        @relation(fields: [submoduleId], references: [id], onDelete: Restrict)
  priority        String                      @default("Medium")
  status          String                      @default("Not Started")
  startDate       DateTime?                   @map("start_date")
  dueDate         DateTime?                   @map("due_date")
  estimatedEffort Float?                      @map("estimated_effort")
  effortUnit      String                      @default("hours") @map("effort_unit")
  actualEffort    Float?                      @map("actual_effort")
  labelsJson      String?                     @map("labels_json") @db.Text
  position        Int                         @default(0)
  createdById     Int                         @map("created_by")
  createdBy       User                        @relation("DevTaskCreator", fields: [createdById], references: [id], onDelete: Cascade)
  completedAt     DateTime?                   @map("completed_at")
  createdAt       DateTime                    @default(now()) @map("created_at")
  updatedAt       DateTime                    @updatedAt @map("updated_at")

  assignees       DevelopmentTaskAssignee[]
  attachments     DevelopmentTaskAttachment[]
  comments        DevelopmentTaskComment[]
  activities      DevelopmentTaskActivity[]

  @@unique([projectId, taskKey])
  @@index([projectId, status])
  @@index([projectId, priority])
  @@index([projectId, moduleId, submoduleId])
  @@index([projectId, dueDate])
  @@index([createdById])
  @@map("development_tasks")
}

model DevelopmentTaskAssignee {
  id           Int             @id @default(autoincrement())
  taskId       Int             @map("task_id")
  task         DevelopmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  userId       Int             @map("user_id")
  user         User            @relation("DevTaskAssigneeUser", fields: [userId], references: [id], onDelete: Cascade)
  assignedById Int?            @map("assigned_by")
  assignedBy   User?           @relation("DevTaskAssignedByUser", fields: [assignedById], references: [id], onDelete: SetNull)
  assignedAt   DateTime        @default(now()) @map("assigned_at")

  @@unique([taskId, userId])
  @@index([userId])
  @@map("development_task_assignees")
}

model DevelopmentTaskAttachment {
  id           Int              @id @default(autoincrement())
  taskId       Int              @map("task_id")
  task         DevelopmentTask  @relation(fields: [taskId], references: [id], onDelete: Cascade)
  projectId    Int              @map("project_id")
  project      Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  documentId   Int?             @map("document_id")
  document     ProjectDocument? @relation(fields: [documentId], references: [id], onDelete: SetNull)
  fileName     String           @map("file_name")
  fileUrl      String?          @map("file_url") @db.Text
  fileSize     Int?             @map("file_size")
  mimeType     String?          @map("mime_type")
  uploadedById Int?             @map("uploaded_by")
  uploadedBy   User?            @relation("DevTaskAttachmentUploader", fields: [uploadedById], references: [id], onDelete: SetNull)
  createdAt    DateTime         @default(now()) @map("created_at")

  @@index([taskId])
  @@index([projectId])
  @@index([documentId])
  @@map("development_task_attachments")
}

model DevelopmentTaskComment {
  id        Int             @id @default(autoincrement())
  taskId    Int             @map("task_id")
  task      DevelopmentTask @relation(fields: [taskId], references: [id], onDelete: Cascade)
  authorId  Int             @map("author_id")
  author    User            @relation("DevTaskCommentAuthor", fields: [authorId], references: [id], onDelete: Cascade)
  body      String          @db.Text
  createdAt DateTime        @default(now()) @map("created_at")
  updatedAt DateTime        @updatedAt @map("updated_at")

  @@index([taskId, createdAt])
  @@map("development_task_comments")
}

model DevelopmentTaskActivity {
  id            Int              @id @default(autoincrement())
  projectId     Int              @map("project_id")
  project       Project          @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskId        Int?             @map("task_id")
  task          DevelopmentTask? @relation(fields: [taskId], references: [id], onDelete: Cascade)
  actorId       Int?             @map("actor_id")
  actor         User?            @relation("DevTaskActivityActor", fields: [actorId], references: [id], onDelete: SetNull)
  action        String
  field         String?
  previousValue String?          @map("previous_value") @db.Text
  newValue      String?          @map("new_value") @db.Text
  metadata      String?          @db.Text
  createdAt     DateTime         @default(now()) @map("created_at")

  @@index([projectId, createdAt])
  @@index([taskId, createdAt])
  @@map("development_task_activities")
}

model DevelopmentProjectConfig {
  id                  Int      @id @default(autoincrement())
  projectId           Int      @unique @map("project_id")
  project             Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  taskPrefix          String   @default("DEV") @map("task_prefix")
  customTaskTypesJson String?  @map("custom_task_types_json") @db.Text
  customStatusesJson  String?  @map("custom_statuses_json") @db.Text
  defaultEffortUnit   String   @default("hours") @map("default_effort_unit")
  updatedById         Int?     @map("updated_by")
  updatedAt           DateTime @updatedAt @map("updated_at")

  @@map("development_project_configs")
}


