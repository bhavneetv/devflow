PORT=5000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173

# Local MySQL (XAMPP):
# DATABASE_URL="mysql://root:@localhost:3306/devflow_db"

# Cloud MySQL (TiDB Cloud Serverless / Aiven / Remote):
DATABASE_URL="mysql://root:@localhost:3306/devflow_db"

# Secret key for JWT session tokens (generate any random string for production)
JWT_SECRET=devflow_secret_key_change_in_production

# GitHub Integration (OAuth or Personal Access Token)
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=
GITHUB_CALLBACK_URL=http://localhost:5173/git/callback
GITHUB_TOKEN=
